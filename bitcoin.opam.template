# Development pins for the coordinated native crypto source.
# Pins select versions; optional packages are installed only when required.
# mirage-crypto-rng-mirage is not a dependency of bitcoin itself, but the Solo5
# smoke unikernel's default_random pulls it in, and opam-monorepo refuses a
# lock that vendors one dev-repo (mirage-crypto) from two different URLs.
pin-depends: [
  [ "mirage-crypto.2.4.0" "git+https://github.com/reuna-labs/mirage-crypto.git#2dca1e4fd8f70ac26984785c8af6d2bd8fee63f9" ]
  [ "mirage-crypto-rng.2.4.0" "git+https://github.com/reuna-labs/mirage-crypto.git#2dca1e4fd8f70ac26984785c8af6d2bd8fee63f9" ]
  [ "mirage-crypto-rng-mirage.2.4.0" "git+https://github.com/reuna-labs/mirage-crypto.git#2dca1e4fd8f70ac26984785c8af6d2bd8fee63f9" ]
  [ "mirage-crypto-secp256k1.2.4.0" "git+https://github.com/reuna-labs/mirage-crypto.git#2dca1e4fd8f70ac26984785c8af6d2bd8fee63f9" ]
  [ "mirage-crypto-bip32.2.4.0" "git+https://github.com/reuna-labs/mirage-crypto.git#2dca1e4fd8f70ac26984785c8af6d2bd8fee63f9" ]
  [ "mirage-crypto-pbkdf2.2.4.0" "git+https://github.com/reuna-labs/mirage-crypto.git#2dca1e4fd8f70ac26984785c8af6d2bd8fee63f9" ]
  [ "digestif.1.4.0" "git+https://github.com/reuna-labs/digestif.git#770f9c355bd5fd60ebf63027b66a51920906519f" ]
]
