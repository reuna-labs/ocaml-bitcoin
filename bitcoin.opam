# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "4.0.0~alpha1"
synopsis:
  "Bitcoin primitives: keys, addresses, script, transactions, Taproot, PSBT"
description: """
A Bitcoin library for OCaml covering consensus serialization, keys and
addresses, Bitcoin Script, transactions, all three sighash algorithms
(legacy, BIP143 segwit v0, BIP341 Taproot), Taproot key- and script-path
spends, BIP32/BIP39 hierarchical deterministic wallets, and BIP174 PSBT
with BIP371 Taproot fields.

The core library performs no I/O and does not depend on Unix, so it builds
unmodified as a MirageOS/Solo5 unikernel."""
maintainer: ["Gil Bahat <bahat.gil@gmail.com>"]
authors: ["Gil Bahat <bahat.gil@gmail.com>"]
license: "ISC"
tags: ["bitcoin" "cryptocurrency" "taproot" "psbt" "segwit" "org:mirage"]
homepage: "https://github.com/reuna-labs/ocaml-bitcoin"
doc: "https://reuna-labs.github.io/ocaml-bitcoin/"
bug-reports: "https://github.com/reuna-labs/ocaml-bitcoin/issues"
depends: [
  "ocaml" {>= "4.14.0"}
  "dune" {>= "3.6" & >= "3.6"}
  "eqaf"
  "digestif" {>= "1.2.0"}
  "base64" {>= "3.5.0"}
  "mirage-crypto-secp256k1"
  "mirage-crypto-rng" {>= "2.1.0"}
  "mirage-crypto-bip32"
  "alcotest" {with-test}
  "qcheck-alcotest" {with-test}
  "ohex" {with-test & >= "0.2.0"}
  "yojson" {with-test & >= "2.0.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/reuna-labs/ocaml-bitcoin.git"
# DEVELOPMENT ONLY -- delete this file before submitting to opam-repository.
# Independent native secp256k1 and BIP32 packages, pinned to the tested revision.
# Keep every Mirage crypto package at the same revision/version.
pin-depends: [
  [ "mirage-crypto.2.4.0" "git+https://github.com/reuna-labs/mirage-crypto.git#2bbb759fdc6463aa8468ccaf0b06244de1244497" ]
  [ "mirage-crypto-rng.2.4.0" "git+https://github.com/reuna-labs/mirage-crypto.git#2bbb759fdc6463aa8468ccaf0b06244de1244497" ]
  [ "mirage-crypto-secp256k1.2.4.0" "git+https://github.com/reuna-labs/mirage-crypto.git#2bbb759fdc6463aa8468ccaf0b06244de1244497" ]
  [ "mirage-crypto-bip32.2.4.0" "git+https://github.com/reuna-labs/mirage-crypto.git#2bbb759fdc6463aa8468ccaf0b06244de1244497" ]
  [ "digestif.1.4.0" "git+https://github.com/reuna-labs/digestif.git#0c969604c4d7022fc8fde05a5224ff31a72401f0" ]
]
