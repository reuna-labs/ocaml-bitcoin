; Zarith is deliberately absent here: only the secp256k1 backend needs
; bignums, so GMP enters the dependency graph at exactly one point and can
; leave it again the day constant-time scalar addition lands upstream.

(library
 (name bitcoin)
 (public_name bitcoin)
 (libraries digestif base64 bitcoin.backend))

; The BIP39 wordlist is compiled in, never read from disk: a unikernel has
; no filesystem to read it from.

(rule
 (target bip39_wordlist.ml)
 (deps
  (:txt %{project_root}/bip39/english.txt)
  (:gen %{project_root}/bip39/gen/gen_wordlist.exe))
 (action
  (with-stdout-to
   %{target}
   (run %{gen} %{txt}))))
